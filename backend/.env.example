PORT=5000

# PostgreSQL
POSTGRES_URI=postgresql://user:password@localhost:5432/mydb
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/mytestdb

# Auth
JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# CORS — comma-separated list of allowed frontend origins
# Include the deployed frontend URL and any local dev URLs
ALLOWED_ORIGINS=https://your-render-url.onrender.com,http://localhost:5173,http://localhost:3000

# Set to your deployed frontend URL in production (e.g. https://pawmatch.netlify.app)
FRONTEND_URL=http://localhost:5173
